{
  "name": "mayfly",
  "version": "0.15.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Mayfly desktop application workspace",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "pnpm --filter @mayfly/desktop dev",
    "dev:web": "pnpm --filter @mayfly/desktop dev:web",
    "dev:website": "pnpm --filter @mayfly/website dev",
    "build:website": "pnpm --filter @mayfly/website build",
    "test:website": "pnpm --filter @mayfly/website test",
    "test:frontend": "pnpm --filter @mayfly/desktop test",
    "build": "pnpm --filter @mayfly/desktop build",
    "build:macos": "pnpm --filter @mayfly/desktop build:macos",
    "build:macos:arm64": "pnpm --filter @mayfly/desktop build:macos:arm64",
    "build:macos:x64": "pnpm --filter @mayfly/desktop build:macos:x64",
    "build:windows": "pnpm --filter @mayfly/desktop build:windows",
    "build:linux": "pnpm --filter @mayfly/desktop build:linux",
    "build:web": "pnpm --filter @mayfly/desktop build:web",
    "typecheck": "pnpm --filter @mayfly/desktop typecheck && pnpm --filter @mayfly/website typecheck",
    "check:rust": "pnpm --filter @mayfly/desktop check:rust",
    "check": "biome ci --error-on-warnings . && pnpm typecheck && pnpm version:check && pnpm licenses:check && pnpm test:scripts && pnpm test:frontend",
    "licenses:generate": "node scripts/licenses.mjs generate",
    "licenses:check": "node scripts/licenses.mjs check",
    "version:check": "node scripts/version.mjs check",
    "test:scripts": "node --test scripts/*.test.mjs",
    "release": "node scripts/version.mjs release",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2"
  }
}
