{
  "name": "filehop",
  "version": "0.0.0",
  "private": true,
  "description": "FileHop desktop application workspace",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "pnpm --filter @filehop/desktop dev",
    "dev:web": "pnpm --filter @filehop/desktop dev:web",
    "build": "pnpm --filter @filehop/desktop build",
    "build:web": "pnpm --filter @filehop/desktop build:web",
    "typecheck": "pnpm --filter @filehop/desktop typecheck",
    "check:rust": "pnpm --filter @filehop/desktop check:rust",
    "check": "biome ci --error-on-warnings . && pnpm typecheck",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2"
  }
}
