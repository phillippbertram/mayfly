{
  "name": "@mayfly/desktop",
  "version": "0.8.0",
  "private": true,
  "description": "Mayfly Tauri desktop application",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:macos": "tauri build --bundles app,dmg -- --locked",
    "build:macos:arm64": "tauri build --target aarch64-apple-darwin --bundles app,dmg -- --locked",
    "build:macos:x64": "tauri build --target x86_64-apple-darwin --bundles app,dmg -- --locked",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis -- --locked",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu --bundles appimage,deb -- --locked",
    "build:web": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-hotkeys": "0.21.0",
    "@tanstack/react-query": "5.105.1",
    "@tauri-apps/api": "2.12.4",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
