{
  "name": "@mayfly/website",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-release.mjs && node scripts/prepare-demo.mjs && next dev --hostname 127.0.0.1 --port 3037",
    "build": "node scripts/prepare-release.mjs && node scripts/prepare-demo.mjs && next build",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test": "node --test scripts/release.test.mjs",
    "release:pull": "node scripts/pull-release.mjs",
    "check:export": "python3 scripts/check-export.py",
    "preview": "python3 scripts/serve-export.py"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.9",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/mdx": "2.0.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
